--  GNAT project file for Alire / gprbuild.  The Makefile (gnatmake) stays the main front end; both build the same program.
project Diary_Sim is
   for Source_Dirs use (".");
   for Object_Dir use "obj/gpr";
   for Exec_Dir use "bin";
   for Main use ("diary_sim.adb");

   package Builder is
      for Executable ("diary_sim.adb") use "diary_sim";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnatwa", "-gnat2022", "-gnata");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;
end Diary_Sim;
